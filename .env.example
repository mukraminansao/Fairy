# Development-only placeholders. Never commit a real .env file.
# Create a new, isolated FAIRY database before running migrations.
DATABASE_URL="postgresql://fairy_dev:CHANGE_ME@localhost:5432/fairy_dev?schema=public"
AUTH_SECRET="GENERATE_RANDOM_SECRET_BEFORE_RUNNING"
AUTH_URL="http://127.0.0.1:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional: local development sign-in for an existing test user.
# FAIRY_DEV_EMAIL=customer@fairy.test
# FAIRY_DEV_AUTH_PASSWORD=GENERATE_A_DIFFERENT_RANDOM_PASSWORD

# Optional: configure only after choosing an OpenID Connect provider.
# AUTH_OIDC_ISSUER=
# AUTH_OIDC_CLIENT_ID=
# AUTH_OIDC_CLIENT_SECRET=

# Future integrations remain UNCONFIGURED by design:
# PAYMENT_PROVIDER=
# STORAGE_BUCKET=
# NEXT_PUBLIC_ENABLE_LIVE_AR=false
# Optional, local development only: run npm run camera:setup first.
# FAIRY_CAMERA_PREVIEW=false
# Optional: exact trusted HTTPS origin for controlled physical-device development testing.
# FAIRY_CAMERA_DEV_ORIGIN=
